# 应用配置
APP_NAME=OpsDiagnosis
DEBUG=False
HOST=0.0.0.0
PORT=9900

# 安全与租户配置（生产环境必须启用认证并使用高强度随机密钥）
AUTH_ENABLED=False
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_ISSUER=
AUDIT_ENABLED=True
DEFAULT_TENANT_ID=public
CORS_ALLOWED_ORIGINS=http://localhost:9900,http://127.0.0.1:9900

# 模型路由、预算与超时
LLM_PROVIDER=deepseek
LLM_FALLBACK_MODELS=
LLM_ALLOWED_BASE_URLS=https://api.deepseek.com
LLM_PRICING_JSON={"deepseek-chat":{"input":0.27,"output":1.10},"deepseek-reasoner":{"input":0.55,"output":2.19}}
MONTHLY_BUDGET_USD=0
MAX_CONCURRENT_TASKS=20
TOOL_CALL_TIMEOUT_SECONDS=30
DIAGNOSIS_TIMEOUT_SECONDS=900

# 任务、状态与持久化后端
INLINE_TASK_EXECUTION=True
WORKER_POLL_INTERVAL_SECONDS=1
TASK_STALE_SECONDS=300
MAX_TASK_EVENTS=500
MAX_TASK_EVENT_BYTES=65536
TASK_STORE_BACKEND=sqlite
TASK_STORE_PATH=volumes/tasks.db
STATE_STORE_BACKEND=
POSTGRES_DSN=
CHECKPOINT_BACKEND=memory
CHECKPOINT_POSTGRES_DSN=
USAGE_STORE_PATH=volumes/usage.db
MEMORY_STORE_PATH=volumes/memories.db

# DeepSeek 配置（对话模型）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 硅基流动配置（Embedding 模型）
SILICONFLOW_API_KEY=sk-your-siliconflow-api-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# Milvus 配置
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000

# RAG 配置
RAG_TOP_K=3
RAG_MODEL=deepseek-chat

# AIOps 专业 Agent 模型（留空则跟随 RAG_MODEL/运行时模型路由）
# 日志扫描可用低延迟模型，Supervisor 仲裁建议使用强推理模型。
AIOPS_LOG_MODEL=deepseek-chat
AIOPS_MONITOR_MODEL=deepseek-chat
AIOPS_KNOWLEDGE_MODEL=deepseek-chat
AIOPS_SUPERVISOR_MODEL=deepseek-reasoner

# Specialist ReAct 多轮工具调用最大迭代次数（全局默认值，可在 skills/agents/*.yaml 中按 agent 覆盖）
AIOPS_SPECIALIST_MAX_ITERATIONS=5
AIOPS_SPECIALIST_MAX_TOOL_CALLS=12
AIOPS_SPECIALIST_REPEAT_CALL_LIMIT=2

# 文档分块配置
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100

# MCP 服务配置
# 支持的 transport 类型：stdio（本地进程）、streamable-http（HTTP 流）
# 也可以配置真实的cls mcp服务： https://cloud.tencent.com/developer/mcp/server/11710
MCP_CLS_TRANSPORT=streamable-http
MCP_CLS_URL=http://localhost:8003/mcp
MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://localhost:8004/mcp
