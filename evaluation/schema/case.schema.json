{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops-diagnosis.local/schemas/evaluation-case-1.0.0.json",
  "title": "AIOps Agent evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "schema_version", "split", "review_status", "labels", "tenant_context", "incident", "observations", "oracle", "constraints", "provenance"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^AIOPS-[0-9]{4}$"},
    "schema_version": {"const": "1.0.0"},
    "split": {"enum": ["development", "sealed_test"]},
    "review_status": {"enum": ["draft", "reviewed", "approved", "rejected"]},
    "labels": {
      "type": "object", "additionalProperties": false,
      "required": ["category", "scenario_family_id", "difficulty", "root_cause_mode", "cross_tenant_risk"],
      "properties": {
        "category": {"enum": ["service_availability", "api_latency_timeout", "cpu_saturation", "memory_oom", "database", "network_dependency", "deployment_configuration", "business_error", "storage_queue_capacity", "security_tenant"]},
        "scenario_family_id": {"type": "string", "pattern": "^[a-z_]+-s[1-5]-c[1-5]$"},
        "difficulty": {"enum": ["easy", "medium", "hard"]},
        "root_cause_mode": {"enum": ["single", "multiple"]},
        "cross_tenant_risk": {"type": "boolean"}
      }
    },
    "tenant_context": {
      "type": "object", "additionalProperties": false,
      "required": ["request_tenant_id", "allowed_tenant_ids", "prohibited_tenant_ids"],
      "properties": {
        "request_tenant_id": {"type": "string", "minLength": 1},
        "allowed_tenant_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "prohibited_tenant_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "incident": {
      "type": "object", "additionalProperties": false,
      "required": ["prompt", "service_name", "environment", "severity", "time_window", "recent_change"],
      "properties": {
        "prompt": {"type": "string", "minLength": 20},
        "service_name": {"type": "string", "minLength": 1},
        "environment": {"enum": ["production", "staging"]},
        "severity": {"enum": ["warning", "high", "critical"]},
        "time_window": {
          "type": "object", "additionalProperties": false, "required": ["start", "end"],
          "properties": {"start": {"type": "string", "format": "date-time"}, "end": {"type": "string", "format": "date-time"}}
        },
        "recent_change": {"type": ["string", "null"]}
      }
    },
    "observations": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidence_id", "source", "tenant_id", "access_scope", "content", "supports_root_cause_ids"],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^E[0-9]+$"},
          "source": {"enum": ["alert", "log", "metric", "topology", "change", "knowledge"]},
          "tenant_id": {"type": "string"},
          "access_scope": {"enum": ["allowed", "prohibited_decoy"]},
          "content": {"type": "string", "minLength": 3},
          "supports_root_cause_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}}
        }
      }
    },
    "oracle": {
      "type": "object", "additionalProperties": false,
      "required": ["root_causes", "required_tools", "optional_tools", "forbidden_tools", "required_evidence_ids", "recommended_action_ids", "must_abstain"],
      "properties": {
        "root_causes": {
          "type": "array", "minItems": 1, "maxItems": 3,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["root_cause_id", "title", "aliases", "supporting_evidence_ids"],
            "properties": {
              "root_cause_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
              "title": {"type": "string", "minLength": 2},
              "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
              "supporting_evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^E[0-9]+$"}}
            }
          }
        },
        "required_tools": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "optional_tools": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "forbidden_tools": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "required_evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^E[0-9]+$"}},
        "recommended_action_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}},
        "must_abstain": {"type": "boolean"}
      }
    },
    "constraints": {
      "type": "object", "additionalProperties": false,
      "required": ["max_steps", "max_tool_calls", "injected_failures"],
      "properties": {
        "max_steps": {"type": "integer", "minimum": 1, "maximum": 20},
        "max_tool_calls": {"type": "integer", "minimum": 0, "maximum": 30},
        "injected_failures": {"type": "array", "items": {"type": "object"}}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source_type", "generator_version", "template_id", "reviewer_ids"],
      "properties": {
        "source_type": {"enum": ["synthetic", "anonymized_internal", "public_incident"]},
        "generator_version": {"type": "string"},
        "template_id": {"type": "string"},
        "reviewer_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
